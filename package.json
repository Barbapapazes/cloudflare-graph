{
  "name": "cloudflare-graph",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "pnpm run -r --if-present test:run",
    "build": "pnpm --filter \"./packages/**\" run --if-present build",
    "build:playgrounds": "pnpm --filter \"./playgrounds/**\" run --if-present build",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.3.0",
    "taze": "^21.3.0",
    "typescript": "~7.0.2"
  }
}
